# app·migrate 컨테이너 런타임 env (compose env_file).
# 실제 파일은 deploy/.env.production (git-ignored, EC2에서 chmod 600). 이 예시를 복사해 채운다.
# 주의: NEXT_PUBLIC_* 는 빌드 타임에 클라 번들로 인라인됨 — CI 빌드 시 --build-arg 로도 동일 값 주입 필요.

# DB — 내부 postgres 서비스(host=postgres, 5432). deploy/.env 의 POSTGRES_* 와 자격증명 일치
DATABASE_URL=postgresql://ffwpu:change-me-strong-password@postgres:5432/ffwpu_social

# NextAuth — AUTH_SECRET 은 신규 발급(openssl rand -base64 32), Vercel 값 재사용 금지. AUTH_URL 은 admin 도메인
AUTH_SECRET=
AUTH_URL=https://admin.sowgood.example

# 스토리지 — R2 유지 (egress 무료). 단일 버킷 최소권한 토큰
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ffwpu-social
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# 사이트
NEXT_PUBLIC_SITE_URL=https://sowgood.example
NEXT_PUBLIC_GA_ID=

# KPI 시트 동기화 cron
KPI_SHEET_CSV_URL=
CRON_SECRET=
