# docker-compose.prod.yml 의 ${} 인터폴레이션용 변수.
# 실제 파일은 deploy/.env (git-ignored, EC2에서 chmod 600). 이 예시를 복사해 채운다.

# 배포 이미지 — CI(GitHub Actions)가 GHCR에 push한 git-sha 태그로 교체
APP_IMAGE=ghcr.io/fornerds/ffwpu-social:latest
MIGRATE_IMAGE=ghcr.io/fornerds/ffwpu-social-migrate:latest

# 도메인 — Caddy 자동 TLS + proxy.ts host 분기. DNS A레코드가 이 인스턴스 Elastic IP를 가리켜야 함
SITE_DOMAIN=sowgood.example
ADMIN_DOMAIN=admin.sowgood.example

# 내부 Postgres (호스트 포트 미개방, docker 네트워크 전용) — 아래 값은 .env.production의 DATABASE_URL과 일치
POSTGRES_USER=ffwpu
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ffwpu_social
