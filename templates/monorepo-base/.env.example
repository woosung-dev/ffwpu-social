# ============================================================
# 루트 .env.example — 모든 앱이 공유하는 환경변수 SSOT
# 실제 값은 .env.local 또는 Vercel 대시보드에서 관리.
# 코드에 하드코딩 절대 금지.
# ============================================================

# --- 데이터베이스 (web + admin 공유) ---
# 로컬: Docker Postgres (예: postgres://postgres:postgres@localhost:5432/myapp)
# 프로덕션: Neon / RDS / Supabase 등 URL 형식 동일
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapp

# --- NextAuth v5 ---
# WARNING: web 과 admin 은 별도 secret 발급 (공유 금지 — 세션 교차 위조 방지)
# 각 앱 .env.local 에서 따로 정의. 루트는 placeholder 만 표시.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- 공개 URL (NEXT_PUBLIC_ 만 클라이언트 노출) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OAuth provider slots (web 전용, 활성화 시 채움) ---
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=

# --- Node / Vercel ---
NODE_ENV=development
