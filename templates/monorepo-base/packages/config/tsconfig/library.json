{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library — React-aware package preset (packages/features, packages/ui-base, packages/db)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "composite": false
  }
}
