# web 앱 (예: test.com) 환경변수 - 실제 값은 .env.local 또는 Vercel 대시보드에서 관리

# DB - 공유 가능 (admin 과 동일 DATABASE_URL 사용 OK)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myorg

# NextAuth v5 - web 전용 secret (admin 과 절대 공유 금지)
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# 사이트 메타
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MyOrg

# OAuth provider (활성화 전 비워두기)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
