{
  "name": "monorepo-base",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 16 + Drizzle + NextAuth v5 monorepo template (web + admin 도메인 분리)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.15.0 <10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@myorg/web",
    "dev:admin": "turbo run dev --filter=@myorg/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "db:generate": "pnpm --filter @myorg/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @myorg/db drizzle-kit migrate",
    "db:studio": "pnpm --filter @myorg/db drizzle-kit studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "prettier": "^3.4.0"
  }
}
