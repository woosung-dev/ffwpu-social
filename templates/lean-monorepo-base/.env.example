# Lean monorepo 루트 — 양 앱 공통 기본값 (각 앱은 apps/<app>/.env.example 도 함께 복사)
# 사용법: cp .env.example .env.local  (그 후 apps/web, apps/admin 도 동일 처리)

# ─────────────────────────────────────────────────────────────
# Database (12-Factor URL 한 덩어리 — host/port 분리 금지)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev

# ─────────────────────────────────────────────────────────────
# NextAuth v5 — 양 앱이 다른 AUTH_SECRET 권장 (cookie 격리)
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# 어드민 전용 (apps/admin)
ADMIN_AUTH_SECRET=replace-with-different-secret
ADMIN_AUTH_URL=http://localhost:3100

# ─────────────────────────────────────────────────────────────
# Public (NEXT_PUBLIC_* 만 브라우저 노출)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# ─────────────────────────────────────────────────────────────
# Node
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
