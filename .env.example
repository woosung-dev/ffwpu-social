# 환경 변수 SSoT (Single Source of Truth)
# 12-Factor: 코드는 process.env 로만 참조. 하드코딩 금지.
#
# 사용법:
#   cp .env.example .env.local        # 실제 값 입력 후 사용 (.env.local 은 .gitignore 됨)
#
# 작성 규칙:
#   - URL 류는 한 덩어리로 (DATABASE_URL, S3_ENDPOINT 등)
#   - 호스트 포트는 멀티 프로젝트 동시 실행 시 충돌 회피용으로 변수화

# ============================================================
# Docker Compose 로컬 스택 (ADR-020)
# ============================================================

# Postgres 컨테이너 환경
POSTGRES_USER=ffwpu
POSTGRES_PASSWORD=ffwpu_dev
POSTGRES_DB=ffwpu_social
POSTGRES_PORT=5432

# MinIO 컨테이너 환경 (S3 호환 로컬 스토리지)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================
# Application
# ============================================================

# DB 연결 (Drizzle / pg)
# 로컬 Docker: postgresql://ffwpu:ffwpu_dev@localhost:5432/ffwpu_social
# 배포(Neon): Neon 대시보드 connection string 그대로(끝에 ?sslmode=require 포함). pg 드라이버 호환 — 코드 무수정.
DATABASE_URL=postgresql://ffwpu:ffwpu_dev@localhost:5432/ffwpu_social

# NextAuth.js v5 (ADR-020)
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL 은 실제 구동 포트와 일치해야 함 — 불일치 시 미인증 /admin 리다이렉트가 엉뚱한 포트로 가 로컬 어드민 로그인이 막힘.
# 멀티 프로젝트로 PORT=3100 처럼 띄우면 여기도 http://localhost:3100 로 맞출 것.
# 배포 시 어드민 서브도메인 (https://admin.<도메인>) — 인증은 어드민 호스트에서만 발생 (ADR-023).
AUTH_URL=http://localhost:3000
# super 단일 계정 (ADR-012 / ADR-016, 1차에는 super 만). ADMIN_EMAIL 은 런타임 미사용, seed 전용.
ADMIN_EMAIL=admin@ffwpu-social.local
# ADMIN_PASSWORD: seed 스크립트가 평문으로 읽어 내부에서 bcrypt 해시. seed 전용(런타임 미사용).
ADMIN_PASSWORD=

# S3 호환 스토리지 (로컬: MinIO, 배포: R2/S3)
# 배포(Cloudflare R2):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto · S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY=R2 API 토큰 · S3_FORCE_PATH_STYLE=true
#   NEXT_PUBLIC_S3_PUBLIC_URL=버킷 공개 도메인(r2.dev 또는 연결한 커스텀 도메인, 끝 슬래시 없이)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ffwpu-social
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/ffwpu-social

# ============================================================
# 공개 사이트 / SEO / 분석
# ============================================================

# 사이트 공개 URL — OG 이미지·sitemap·canonical 절대경로의 기준. 배포 시 실제 도메인(끝 슬래시 없이).
# 미설정 시 http://localhost:3100 로컬 폴백.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# GA4 측정 ID (G-XXXXXXXXXX) — 설정 시에만 GA 스크립트 로드. 로컬·미발급 시 비워두면 미주입.
NEXT_PUBLIC_GA_ID=

# ============================================================
# KPI 시트 동기화 (사회공헌국 Google Sheets '총 누적 지표' → 랜딩 자동 반영)
# ============================================================

# 시트 '총 누적 지표' 탭의 CSV export URL. 공개 게시(또는 링크 공개) 시트만 인증 없이 읽힘.
#   형식: https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
#   미설정 시 동기화 라우트가 명시 에러 — 랜딩은 기존 DB 값 유지(장애 격리).
KPI_SHEET_CSV_URL=

# 동기화 엔드포인트(/api/cron/sync-kpi) 보호용 시크릿. GitHub Actions 주간 워크플로가 Authorization: Bearer <값> 으로 호출.
#   openssl rand -hex 32 로 생성. 미설정 시 라우트는 403. 같은 값을 GitHub Secrets(CRON_SECRET)에도 등록.
#   참고: 자동 동기화 스케줄은 .github/workflows/sync-kpi.yml (매주 월). 호출 대상 URL 은 GitHub Secret KPI_SYNC_ENDPOINT (앱 env 아님).
CRON_SECRET=

# ============================================================
# 배포 (Vercel + Neon + Cloudflare R2) — Vercel 대시보드 Environment Variables 에 입력
# 아래는 형식 예시(주석). POSTGRES_* / MINIO_* / *_PORT 는 Docker 로컬 전용 → Vercel 에 넣지 않음.
# ============================================================
#
# DATABASE_URL=postgresql://<user>:<pw>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#   └ Neon pooled 엔드포인트(-pooler) 사용 — pg Pool 서버리스 연결 고갈 방지
# AUTH_SECRET=<openssl rand -base64 32 로 새로 생성>
# AUTH_URL=https://admin.<도메인>          # 인증은 어드민 서브도메인에서만 (ADR-023)
#
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # R2 S3 API 엔드포인트 = 업로드 PUT 대상
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2 API 토큰 Access Key>
# S3_SECRET_ACCESS_KEY=<R2 API 토큰 Secret>
# S3_BUCKET=ffwpu-social
# S3_FORCE_PATH_STYLE=true
# NEXT_PUBLIC_S3_PUBLIC_URL=https://pub-<hash>.r2.dev   # R2 공개 읽기 URL(또는 커스텀 도메인). 업로드 엔드포인트와 다른 호스트. 빌드타임 인라인.
#   └ R2 버킷 CORS 필수: AllowedMethods [PUT] · AllowedOrigins [https://admin.<도메인>] · AllowedHeaders [content-type]
#
# 공개 사이트 / SEO / 분석 — Vercel 에도 반드시 입력. 누락 시 localhost 폴백이 아니라 과거/잘못된 도메인이 OG·sitemap·canonical 에 그대로 박힘.
# NEXT_PUBLIC_SITE_URL=https://<공개 도메인>   # 예: https://sowgood.kr (apex). "공개 사이트 보기" 링크·OG·sitemap·canonical 의 기준.
#   └ NEXT_PUBLIC_* 는 빌드타임 인라인 → 값 변경 후 반드시 Redeploy(재빌드) 해야 반영. 단순 환경변수 저장만으로는 기존 배포에 미반영.
#   └ AUTH_URL(어드민 호스트)과 다름: 인증은 admin.<도메인>, 공개 사이트는 apex <도메인>. 두 변수를 같은 값으로 두지 말 것 (ADR-023).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX            # 미설정 시 GA 미주입
# KPI_SHEET_CSV_URL=https://docs.google.com/.../export?format=csv&gid=<GID>   # 미설정 시 동기화 라우트만 에러, 랜딩은 DB 값 유지
# CRON_SECRET=<openssl rand -hex 32>        # /api/cron/sync-kpi 보호. 같은 값 GitHub Secrets 에도 등록
#
# 시드(1회): DATABASE_URL=<prod> ADMIN_EMAIL=... ADMIN_PASSWORD=... (+ S3_* ) pnpm db:migrate && pnpm db:seed
