# 환경 변수 SSoT (Single Source of Truth)
# 12-Factor: 코드는 process.env / os.environ 으로만 참조. 하드코딩 금지.
#
# 사용법:
#   cp .env.example .env.local        # 실제 값 입력 후 사용 (.env.local 은 .gitignore 됨)
#   다운스트림은 본 파일에 자기 프로젝트의 변수만 남기고 나머지 삭제.
#
# 작성 규칙:
#   - 변수당 1줄 + 위에 한국어 1줄 주석 (역할·예시값)
#   - URL 류는 한 덩어리로 (`DATABASE_URL`, `REDIS_URL`, `NEXT_PUBLIC_API_URL`)
#     호스트·포트·자격증명 분리 금지 (12-Factor Config 원칙)
#   - 포트도 변수화 (`API_PORT=8000`) — 멀티 프로젝트 동시 실행 시 충돌 회피
#
# 예시 (다운스트림에서 필요한 것만 남기고 수정):

# DB 연결 (Postgres 예시)
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# Redis (캐시·세션·큐)
# REDIS_URL=redis://localhost:6379/0

# Next.js 클라이언트에 노출되는 API base (NEXT_PUBLIC_ prefix 필수)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# 서버 포트 (멀티 프로젝트 충돌 회피용 변수화)
# API_PORT=8000
# WEB_PORT=3000
