# 환경 변수 SSoT (Single Source of Truth)
# 12-Factor: 코드는 process.env 로만 참조. 하드코딩 금지.
#
# 사용법:
#   cp .env.example .env.local        # 실제 값 입력 후 사용 (.env.local 은 .gitignore 됨)
#
# 작성 규칙:
#   - URL 류는 한 덩어리로 (DATABASE_URL, S3_ENDPOINT 등)
#   - 호스트 포트는 멀티 프로젝트 동시 실행 시 충돌 회피용으로 변수화

# ============================================================
# Docker Compose 로컬 스택 (ADR-020)
# ============================================================

# Postgres 컨테이너 환경
POSTGRES_USER=ffwpu
POSTGRES_PASSWORD=ffwpu_dev
POSTGRES_DB=ffwpu_social
POSTGRES_PORT=5432

# MinIO 컨테이너 환경 (S3 호환 로컬 스토리지)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================================
# Application
# ============================================================

# DB 연결 (Drizzle / pg)
# 로컬 Docker: postgresql://ffwpu:ffwpu_dev@localhost:5432/ffwpu_social
# 배포(Neon): Neon 대시보드 connection string 그대로(끝에 ?sslmode=require 포함). pg 드라이버 호환 — 코드 무수정.
DATABASE_URL=postgresql://ffwpu:ffwpu_dev@localhost:5432/ffwpu_social

# NextAuth.js v5 (ADR-020)
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# super 단일 계정 (ADR-012 / ADR-016, 1차에는 super 만)
ADMIN_EMAIL=admin@ffwpu-social.local
# ADMIN_PASSWORD_HASH는 seed 스크립트에서 bcrypt 해시로 채움 (사용자 비밀번호 입력 후)

# S3 호환 스토리지 (로컬: MinIO, 배포: R2/S3)
# 배포(Cloudflare R2):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto · S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY=R2 API 토큰 · S3_FORCE_PATH_STYLE=true
#   NEXT_PUBLIC_S3_PUBLIC_URL=버킷 공개 도메인(r2.dev 또는 연결한 커스텀 도메인, 끝 슬래시 없이)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ffwpu-social
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/ffwpu-social

# ============================================================
# 공개 사이트 / SEO / 분석
# ============================================================

# 사이트 공개 URL — OG 이미지·sitemap·canonical 절대경로의 기준. 배포 시 실제 도메인(끝 슬래시 없이).
# 미설정 시 http://localhost:3100 로컬 폴백.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# GA4 측정 ID (G-XXXXXXXXXX) — 설정 시에만 GA 스크립트 로드. 로컬·미발급 시 비워두면 미주입.
NEXT_PUBLIC_GA_ID=
